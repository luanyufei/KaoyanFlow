{
  "name": "kaoyanflow",
  "productName": "KaoyanFlow",
  "version": "1.1.0",
  "description": "KaoyanFlow 安装向导",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder -mw",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "kaoyan",
    "study-planner",
    "electron"
  ],
  "author": "luanyufei",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.luanyufei.kaoyanflow",
    "productName": "KaoyanFlow",
    "publish": {
      "provider": "github",
      "owner": "luanyufei",
      "repo": "KaoyanFlow"
    },
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KaoyanFlow",
      "uninstallDisplayName": "KaoyanFlow",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "data-init.js",
      "app.js",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ]
  }
}
